{
  "name": "C++ Inlines & Templates",
  "scopeName": "source.cpp.inlines",
  "fileTypes": [
    "ipp",
    "inl",
    "tpp",
    "tcc",
    "ixx",
    "cppm"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "name": "meta.annotation.cpp",
      "begin": "\\[\\s*\\[",
      "end": "\\]\\s*\\]",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "keyword.other.cpp",
          "match": "\\b(?:using|alignas)\\b"
        },
        {
          "name": "entity.name.decorator.cpp",
          "match": "[A-Za-z0-9_]+"
        },
        {
          "name": "punctuation.separator.cpp",
          "match": "[,:()]"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "entity.name.decorator.cpp"
        }
      },
      "endCaptures": {
        "0": {
          "name": "entity.name.decorator.cpp"
        }
      }
    },
    {
      "name": "keyword.other.cpp",
      "match": "\\b(?:__abstract|__alignof|__asm|__assume|__based|__box|__builtin_alignof|__cdecl|__clrcall|__declspec|__delegate|__event|__except|__fastcall|__finally|__forceinline|__gc|__hook|__identifier|__if_exists|__if_not_exists|__inline|__int128|__int16|__int32|__int64|__int8|__interface|__leave|__m128|__m128d|__m128i|__m256|__m256d|__m256i|__m512|__m512d|__m512i|__m64|__multiple_inheritance|__newslot|__nogc|__noop|__nounwind|__novtordisp|__nullptr|__pascal|__pin|__pragma|__property|__ptr32|__ptr64|__raise|__restrict|__resume|__sealed|__single_inheritance|__stdcall|__super|__thiscall|__try|__try_cast|__typeof|__unaligned|__unhook|__uuidof|__value|__virtual_inheritance|__w64|__wchar_t|_asm|_based|_cdecl|_declspec|_fastcall|_if_exists|_if_not_exists|_inline|_multiple_inheritance|_pascal|_single_inheritance|_stdcall|_virtual_inheritance|_w64|abstract|alignas|alignof|amp|and|and_eq|array|auto|bitand|bitor|bool|break|case|catch|char|char16_t|char32_t|char8_t|class|co_await|co_return|co_yield|compl|concept|const|const_cast|consteval|constexpr|constinit|continue|cpu|decltype|default|delegate|delete|do|double|dynamic_cast|each|else|enum|event|explicit|export|extern|false|final|finally|float|for|friend|gcnew|generic|goto|if|import|in|initonly|inline|int|interface|interior_ptr|internal|literal|long|module|mutable|namespace|new|noexcept|not|not_eq|nullptr|operator|or|or_eq|override|partial|pascal|pin_ptr|private|property|protected|public|ref|register|reinterpret_cast|requires|restrict|return|safe_cast|sealed|short|signed|sizeof|static|static_assert|static_cast|struct|switch|template|this|thread_local|throw|tile_static|true|try|typedef|typeid|typename|union|unsigned|using|virtual|void|volatile|wchar_t|where|while|xor|xor_eq)\\b"
    },
    {
      "include": "#numbers"
    },
    {
      "name": "variable.other.cpp",
      "match": "\\b[A-Za-z_]\\w*\\b"
    },
    {
      "name": "punctuation.operator.cpp",
      "match": "<=>|->\\*|->|<<=|>>=|<<|>>|&&|\\|\\||\\+\\+|--|[=><!~?:&|+*/^%\\-]=?"
    },
    {
      "name": "punctuation.separator.cpp",
      "match": "[{}()\\[\\];,.]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.cpp",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/"
        },
        {
          "name": "comment.block.cpp",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.cpp",
          "begin": "//",
          "end": "(?<!\\\\)\\n"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#\\s*include)\\s*(<)([^>]*)(>)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.cpp"
            },
            "2": {
              "name": "keyword.other.directive.cpp"
            },
            "3": {
              "name": "string.quoted.header.cpp"
            },
            "4": {
              "name": "keyword.other.directive.cpp"
            }
          }
        },
        {
          "match": "^\\s*(#\\s*include)\\s*(\")([^\"]*)(\")",
          "captures": {
            "1": {
              "name": "keyword.other.directive.cpp"
            },
            "2": {
              "name": "keyword.other.directive.cpp"
            },
            "3": {
              "name": "string.quoted.header.cpp"
            },
            "4": {
              "name": "keyword.other.directive.cpp"
            }
          }
        },
        {
          "name": "keyword.other.directive.cpp",
          "match": "^\\s*#\\s*\\w+"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.cpp",
          "begin": "(?:u8|u|U|L)?R\"([^ ()\\\\\\t\\r\\n]{0,16})\\(",
          "end": "\\)\\1\""
        },
        {
          "name": "string.quoted.double.cpp",
          "begin": "(?:u8|u|U|L)?\"",
          "end": "\"|(?<!\\\\)\\n",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.cpp",
          "begin": "(?:u8|u|U|L)?'",
          "end": "'|(?<!\\\\)\\n",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.cpp",
          "match": "\\\\(?:[0abfnrtv\\\\\"'?]|[0-7]{1,3}|x[0-9A-Fa-f]+|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.escape.cpp",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cpp",
          "match": "(?<![\\w.])(?:0[xX](?:[0-9a-fA-F](?:'?[0-9a-fA-F])*(?:\\.(?:[0-9a-fA-F](?:'?[0-9a-fA-F])*)?)?|\\.[0-9a-fA-F](?:'?[0-9a-fA-F])*)[pP][+-]?[0-9]+|(?:[0-9](?:'?[0-9])*)?\\.[0-9](?:'?[0-9])*(?:[eE][+-]?[0-9]+)?|[0-9](?:'?[0-9])*\\.(?:[eE][+-]?[0-9]+)?|[0-9](?:'?[0-9])*[eE][+-]?[0-9]+)[fFlL]?(?:_[A-Za-z_]\\w*)?(?!\\w)"
        },
        {
          "name": "constant.numeric.integer.cpp",
          "match": "\\b(?:0[xX][0-9a-fA-F](?:'?[0-9a-fA-F])*|0[bB][01](?:'?[01])*|[0-9](?:'?[0-9])*)(?:(?:[uU](?:ll|LL|[lLzZ])?|(?:ll|LL|[lLzZ])[uU]?)|_[A-Za-z_]\\w*)?(?!\\w)"
        }
      ]
    }
  }
}
