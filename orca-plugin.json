{
  "manifestVersion": 2,
  "id": "cpp-kit",
  "publisher": "be0hhh",
  "name": "C/C++ & CMake Kit",
  "version": "1.1.1",
  "execution": "data",
  "description": "C++ inline/template and module syntax with native-style colors, CMake scripts, and CMake cache highlighting.",
  "cover": {
    "path": "assets/cover.jpg",
    "alt": "C/C++ & CMake Kit"
  },
  "license": "MIT",
  "repository": "https://github.com/be0hhh/orca-cpp-kit",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "syntaxes": [
      {
        "id": "cpp-inlines",
        "title": "C++ Inlines & Templates",
        "scopeName": "source.cpp.inlines",
        "path": "syntaxes/cpp.tmLanguage.json",
        "configuration": "syntaxes/cpp-configuration.json",
        "extensions": [
          ".ipp",
          ".inl",
          ".tpp",
          ".tcc",
          ".ixx",
          ".cppm"
        ],
        "filenames": []
      },
      {
        "id": "cmake",
        "title": "CMake",
        "scopeName": "source.cmake",
        "path": "syntaxes/cmake.tmLanguage.json",
        "configuration": "syntaxes/cmake-configuration.json",
        "extensions": [
          ".cmake"
        ],
        "filenames": [
          "CMakeLists.txt"
        ]
      },
      {
        "id": "cmake-cache",
        "title": "CMake Cache",
        "scopeName": "source.cmake-cache",
        "path": "syntaxes/cmake-cache.tmLanguage.json",
        "configuration": "syntaxes/cmake-configuration.json",
        "extensions": [],
        "filenames": [
          "CMakeCache.txt"
        ]
      }
    ],
    "newFiles": [
      {
        "id": "cpp-example",
        "title": "C++ template example",
        "extension": ".ipp",
        "template": "samples/math_vector.ipp"
      },
      {
        "id": "module-example",
        "title": "C++ module example",
        "extension": ".cppm",
        "template": "samples/example.cppm"
      },
      {
        "id": "cmake-example",
        "title": "CMake script example",
        "extension": ".cmake",
        "template": "samples/example.cmake"
      }
    ]
  },
  "capabilities": []
}
